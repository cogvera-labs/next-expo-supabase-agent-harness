    "monorepo",
    "pnpm",
    "typescript",
    "starter",
    "template",
    "boilerplate",
    "scaffold",
    "cli",
    "supply-chain-security",
    "provenance"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.5",
    "eslint": "9.39.5",
    "eslint-plugin-sonarjs": "4.2.2",
