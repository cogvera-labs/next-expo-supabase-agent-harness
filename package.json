  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogvera-labs/next-expo-supabase-agent-harness.git"
  },
  "bin": {
    "next-expo-supabase-agent-harness": "installer/cli.mjs"
  },
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "installer",
    "template",
    "CHANGELOG.md",
    "REUSE.toml",
    "LICENSE",
