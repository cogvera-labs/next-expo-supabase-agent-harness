# Normalize line endings so Windows checkouts keep LF — this covers both the
# selftest CI runners and consumers who clone via the GitHub template flow.
# Without it, autocrlf=true converts the template tree to CRLF at checkout and
# the scaffolded project's biome format gate fails on every file.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary assets (the installer copies these as Buffers; keep them byte-exact)
*.png binary
*.ico binary
*.icns binary

# Generated-but-committed artifacts inside the shipped template
template/stack/packages/design-tokens/src/generated/** linguist-generated=true
template/stack/packages/platform/supabase/src/types.ts linguist-generated=true
template/base/tools/generated/** linguist-generated=true

# Generated-but-committed files of the factory itself. GitHub collapses their diffs in pull
# requests by default, so review the source and the generator instead.
# plugin/{agents,commands,skills}: copies of template/base/.claude/, written by
# `node scripts/generate-plugin-folder.mjs --write`; check-plugin-manifest.mjs fails on drift.
plugin/agents/** linguist-generated=true
plugin/commands/** linguist-generated=true
plugin/skills/** linguist-generated=true
# template/shas: the released-sha tables, written by
# `node scripts/generate-released-shas.mjs --current`; check-released-shas.mjs fails when stale.
template/shas/** linguist-generated=true
